{
  "name": "@leafos/core",
  "version": "0.0.0",
  "description": "LeafOS Core and its public protocol, client, and adapter contracts",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "packageManager": "npm@11.19.1",
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./client": {
      "types": "./dist/protocol/client/index.d.ts",
      "import": "./dist/protocol/client/index.js",
      "default": "./dist/protocol/client/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter-api/index.d.ts",
      "import": "./dist/adapter-api/index.js",
      "default": "./dist/adapter-api/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:package": "node --test tests/packaging/package.test.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run test:unit && npm run test:package",
    "prepack": "npm run typecheck && npm run check:boundaries && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
